use fmt;

type User = struct {
    Name: str,
    age: u32,

    fn Greet() str = {
        return "hi, " + Name;
    };

    fn Birthday() void = {
        age += 1;
    };
};

fn main() void or error = {
    var u = User { Name = "Alice", age = 30 };
    u.Birthday();
    fmt.Println(u.Greet()) or return;
    fmt.Println(u.age) or return;
    var p = &u;
    p.Name = "Bob";
    fmt.Println(u.Greet()) or return;
};
