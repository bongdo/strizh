use fmt;

type Node = struct {
    value: i32,
    next: *Node,
};

fn main() void or error = {
    var p = nil[*Node];
    if (p == nil[*Node]) {
        fmt.Println("nil") or return;
    };
    var m = map[str, i32] {};
    m["a"] = 1;
    fmt.Println(has(m, "a"), m["b"]) or return;
    delete(m, "a");
    fmt.Println(has(m, "a")) or return;
    var xs = i32[] {};
    xs = append(xs, 1, 2);
    fmt.Println(len(xs), xs[1]) or return;
    var arr = i32[3] {1, 2};
    fmt.Println(arr) or return;
};
