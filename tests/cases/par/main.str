use fmt;

fn load(x: i32) i32 or error = {
    return x * 10;
};

fn main() void or error = {
    var a = i32(0);
    var b = i32(0);
    par {
        a = load(1) or return;
        b = load(2) or return;
    };
    fmt.Println(a, b) or return;
    var xs = i32[] {1, 2, 3, 4};
    var out = i32[4] {};
    par for (var i = 0; i < len(xs); i += 1) limit 2 {
        out[i] = xs[i] * 2;
    };
    fmt.Println(out) or return;
    var sum = i32(0);
    within 5s {
        sum = load(3) or return;
    };
    fmt.Println(sum) or return;
};
