use fmt;

type Writer = interface {
    Write(p: u8[]) int or error;
};

type Buffer = struct {
    data: u8[],

    fn Write(p: u8[]) int or error = {
        data = append(data, p...);
        return len(p);
    };

    fn Len() int = {
        return len(data);
    };
};

fn emit(w: Writer, text: str) int or error = {
    var n = w.Write(bytes(text)) or return;
    return n;
};

fn main() void or error = {
    var b = Buffer {};
    var n = emit(&b, "hello") or return;
    fmt.Println(n, b.Len(), str(b.data)) or return;
};
