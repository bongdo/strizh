use fmt;
use errors;

fn load(ok: bool) i32 or error = {
    if (!ok) {
        return errors.New("boom");
    };
    return 42;
};

fn main() void or error = {
    var v = load(true) or return;
    fmt.Println(v) or return;
    var w = i32(0);
    w = load(false) or err {
        fmt.Println("caught:", err) or panic("print");
    };
    fmt.Println(w) or return;
    var z = load(true) or panic("unreachable");
    fmt.Println(z) or return;
};
